    "held_out": ["contextual-intelligence-007", "contextual-intelligence-008", "risk-006", "risk-012", "taste-007", "taste-008"],
    "safety_regression": ["risk-001", "risk-002", "risk-003", "risk-004", "risk-005", "risk-006", "risk-007", "risk-008", "risk-009", "risk-010", "risk-011", "risk-012"],
