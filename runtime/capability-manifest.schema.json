{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joymengistu/Ai-skills/runtime/capability-manifest.schema.json",
  "title": "Ai skills capability manifest",
  "type": "object",
  "required": ["name", "version", "purpose", "triggers", "inputs", "outputs", "dependencies", "permissions", "risk_class", "tests", "owner", "rollback"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"type": "string", "minLength": 1},
    "triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "risk_class": {"type": "string", "enum": ["read_only", "reversible", "consequential", "irreversible", "unknown"]},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "data_retention": {"type": "string"},
    "compatibility": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
