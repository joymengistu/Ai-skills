{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joymengistu/Ai-skills/runtime/intelligence/example-record.schema.json",
  "title": "Skill Example Record",
  "description": "A high-information positive, negative, borderline, exception, transformation, or edge example for a skill principle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "skill_or_principle", "kind", "situation", "response", "why", "expected_observable", "scope", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "record_type": {"const": "example_record"},
    "record_id": {"type": "string", "minLength": 3},
    "skill_or_principle": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["positive", "negative", "borderline", "exception", "transformation", "edge"]},
    "situation": {"type": "string", "minLength": 1},
    "response": {"type": "string", "minLength": 1},
    "why": {"type": "string", "minLength": 1},
    "expected_observable": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "counterexample_of": {"type": ["string", "null"]},
    "transforms": {"type": ["string", "null"]},
    "scope": {"type": "string", "enum": ["skill", "evaluation", "conversation", "project", "repository"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created_by", "source_ref"], "properties": {"created_by": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}}}
  }
}
