{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joymengistu/Ai-skills/runtime/intelligence/lesson-memory.schema.json",
  "title": "Lesson Memory Record",
  "description": "A conditional, evidence-linked lesson derived from an observed failure or correction. A lesson is not automatically authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "observation",
    "failure_class",
    "likely_cause",
    "evidence_refs",
    "lesson",
    "applies_when",
    "does_not_apply_when",
    "proposed_action",
    "expected_benefit",
    "regression_risk",
    "test_cases",
    "status",
    "confidence",
    "provenance",
    "rollback",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "record_type": {"const": "lesson_memory"},
    "record_id": {"type": "string", "minLength": 3},
    "observation": {"type": "string", "minLength": 1},
    "failure_class": {"type": "string", "enum": ["outcome", "factuality", "clarity", "effort", "trust", "control", "progress", "personalization", "completion", "safety", "routing", "tool", "verification", "unknown"]},
    "likely_cause": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "lesson": {"type": "string", "minLength": 1},
    "applies_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "does_not_apply_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "proposed_action": {"type": "string", "minLength": 1},
    "expected_benefit": {"type": "string", "minLength": 1},
    "regression_risk": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "test_cases": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "status": {"type": "string", "enum": ["observed", "candidate", "tested", "promoted", "rejected", "expired"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created_by", "source_hash"], "properties": {"created_by": {"type": "string", "minLength": 1}, "source_hash": {"type": "string", "minLength": 1}}},
    "rollback": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
