{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joymengistu/Ai-skills/runtime/intelligence/research-memory.schema.json",
  "title": "Research Memory Record",
  "description": "An inspectable claim record. It stores evidence and uncertainty without turning a source into an unquestioned conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "claim",
    "status",
    "source_refs",
    "evidence_refs",
    "source_authority",
    "observed_at",
    "confidence",
    "counterevidence",
    "dependent_decisions",
    "scope",
    "expiry_or_review",
    "privacy",
    "provenance",
    "created_at",
    "updated_at",
    "deletion"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "record_type": {"const": "research_memory"},
    "record_id": {"type": "string", "minLength": 3},
    "claim": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["FACT", "EVIDENCE", "INFERENCE", "HYPOTHESIS", "UNKNOWN", "OUTDATED", "CONFLICTING"]},
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_authority": {"type": "string", "enum": ["primary", "direct_observation", "official_secondary", "secondary", "user_provided", "model_generated", "unknown"]},
    "publication_date": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "minLength": 1},
    "freshness_requirement": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "supporting_artifact": {"type": "string", "minLength": 1},
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "dependent_decisions": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "string", "enum": ["repository", "skill", "project", "conversation", "user", "experiment", "source"]},
    "expiry_or_review": {"type": "string", "minLength": 1},
    "privacy": {"type": "string", "enum": ["public", "internal", "user_visible", "sensitive_redacted"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created_by", "source_hash"], "properties": {"created_by": {"type": "string", "minLength": 1}, "source_hash": {"type": "string", "minLength": 1}}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "deletion": {"type": "object", "additionalProperties": false, "required": ["deletable", "path"], "properties": {"deletable": {"type": "boolean"}, "path": {"type": "string", "minLength": 1}}}
  }
}
