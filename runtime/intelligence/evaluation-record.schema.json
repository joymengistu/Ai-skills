{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joymengistu/Ai-skills/runtime/intelligence/evaluation-record.schema.json",
  "title": "Skill Evaluation Record",
  "description": "A normalized evaluation result that keeps task outcome, trajectory, graders, hard gates, and confidence separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "task_id", "trial_id", "subject_version", "grader_records", "outcome_status", "trajectory_status", "hard_gates", "confidence", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "record_type": {"const": "evaluation_record"},
    "record_id": {"type": "string", "minLength": 3},
    "task_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "subject_version": {"type": "string", "minLength": 1},
    "grader_records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["grader_type", "criterion", "score", "evidence_refs", "confidence"], "properties": {"grader_type": {"type": "string", "enum": ["code", "model", "human"]}, "criterion": {"type": "string", "minLength": 1}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "outcome_status": {"type": "string", "enum": ["success", "partial", "failure", "unknown"]},
    "trajectory_status": {"type": "string", "enum": ["verified", "acceptable", "degraded", "unsafe", "unknown"]},
    "hard_gates": {"type": "object", "additionalProperties": false, "required": ["safety", "privacy", "authority", "recoverability"], "properties": {"safety": {"type": "boolean"}, "privacy": {"type": "boolean"}, "authority": {"type": "boolean"}, "recoverability": {"type": "boolean"}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created_by", "created_at", "trace_ref"], "properties": {"created_by": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}, "trace_ref": {"type": "string", "minLength": 1}}}
  }
}
